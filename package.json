{
  "name": "travel-doodles-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend && cp -r frontend/.next .next && cp -r frontend/public public",
    "start": "npm run start --prefix frontend",
    "test": "npm run test --prefix frontend",
    "test:backend": "cd backend && go test ./...",
    "build:backend": "cd backend && go build -o bin/travel-api ./cmd/api",
    "lint": "npm run lint --prefix frontend"
  }
}
