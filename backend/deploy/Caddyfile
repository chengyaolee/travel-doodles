# Caddy Reverse Proxy & TLS Termination
# Low idle memory footprint (~50-80 MB)

{
    email admin@traveldoodles.app
    admin off
}

traveldoodles.app {
    # Encode with modern high-efficiency compression
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    }

    # API and WebSocket proxying
    handle /api/* {
        reverse_proxy travel-api:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Health & Metrics (accessible internally or via authenticated admin)
    handle /healthz {
        reverse_proxy travel-api:8080
    }
    handle /readyz {
        reverse_proxy travel-api:8080
    }

    # Static or Local Media Serving with browser caching
    handle /media/files/* {
        reverse_proxy travel-api:8080
    }

    # Frontend Single Page App or Next.js Reverse Proxy
    handle {
        reverse_proxy frontend:3000
    }
}
