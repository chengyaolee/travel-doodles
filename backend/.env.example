# Travel Doodles Environment Configuration

# Server
PORT=8080
ENV=development
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
BACKEND_DOMAIN=localhost # Set to your VPS domain (e.g. api.yourdomain.com) for automatic Caddy SSL

# Database (PostgreSQL 16+ with PostGIS)
# Max connections should be capped to 20-25 for a 4GB VPS
DATABASE_URL=postgres://travel_user:travel_password@localhost:5432/travel_doodles?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_IDLE_TIME_MINUTES=15

# Cache (Redis 7) - Optional: system degrades gracefully if unavailable
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=travel:

# Object Storage (S3-compatible: Cloudflare R2 / Backblaze B2 / AWS S3 / Local)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=travel-doodles-media
STORAGE_S3_ACCESS_KEY=your_access_key
STORAGE_S3_SECRET_KEY=your_secret_key
STORAGE_PUBLIC_URL=http://localhost:8080/media/files

# Security & Authentication
# 32+ character random string for cookie signature / tokens
SESSION_SECRET=change-this-to-a-very-secure-32-byte-secret-in-production
SESSION_COOKIE_NAME=travel_session
SESSION_DURATION_HOURS=168
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Rate Limiting (Token Bucket / Sliding Window)
RATELIMIT_ENABLED=true
RATELIMIT_REQUESTS_PER_MINUTE=120
RATELIMIT_AUTH_PER_MINUTE=10

# Background Worker
WORKER_CONCURRENCY=4
WORKER_IMAGE_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
